# ── Levertide — environment configuration ──
# Copy this file to ".env" and fill in real values.
# NOTE: This is a static site. The browser does NOT auto-load .env.
# Use these values as the source of truth, then apply them per README §4.

# Your Cal.com discovery-call link, format: username/event-slug
# (set in index.html → Cal.ns[...]("inline", { calLink: ... }))
CAL_LINK=sruti-sharma-95rqnm/discovery-call

# Contact-form POST target — Formspree, n8n webhook, or your own API.
# Exposed to the browser as window.LEVERTIDE_FORM_ENDPOINT
FORM_ENDPOINT=

# Fallback contact email shown if a form submission fails
CONTACT_EMAIL=hello@levertide.com

# Canonical site URL (used for OG/meta tags & link previews)
SITE_URL=https://levertide.com

# Optional analytics (Plausible domain / GA4 ID / PostHog key)
ANALYTICS_ID=
